#!/bin/sh
#
# 스테이징된 자바 파일을 포맷(Spotless)하고 코드 규칙(Checkstyle)을 검사한다.
# 자바 변경이 없는 커밋은 그냥 통과한다.

set -e

# 경로에 공백이 있어도 쪼개지지 않도록 개행만 구분자로 둔다.
IFS='
'

root=$(git rev-parse --show-toplevel)
cd "$root"

# quotePath 를 끄지 않으면 비 ASCII 경로가 8진 이스케이프로 나와 어긋난다.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR \
    -- src | grep '\.java$' || true)
[ -z "$staged" ] && exit 0

# 같은 파일에 스테이징하지 않은 변경이 남아 있는지 본다.
# 이런 파일을 자동 포맷한 뒤 add 하면 스테이징하지 않은 변경까지 딸려 들어간다.
partial=$(git -c core.quotePath=false diff --name-only -- $staged || true)

echo "[pre-commit] 자바 포맷 확인 중..."
if ! ./gradlew spotlessCheck --quiet >/dev/null 2>&1; then

    if [ -n "$partial" ]; then
        echo "[pre-commit] 포맷을 고쳐야 하는데 스테이징하지 않은 변경이 남은 파일이 있습니다:"
        printf '%s\n' "$partial" | sed 's/^/  /'
        echo
        echo "  해당 파일을 모두 스테이징(git add)하거나 커밋을 나눈 뒤 다시 시도하세요."
        exit 1
    fi

    echo "[pre-commit] 자바 포맷 정리 중..."
    if ! ./gradlew spotlessApply --quiet; then
        echo "[pre-commit] 포맷 적용에 실패했습니다."
        exit 1
    fi

    for file in $staged; do
        [ -f "$file" ] && git add -- "$file"
    done
fi

echo "[pre-commit] 코드 규칙 검사 중..."
if ! ./gradlew checkstyleMain checkstyleTest --quiet; then
    echo
    echo "[pre-commit] 코드 규칙 위반이 있습니다. 위 내용을 고친 뒤 다시 커밋하세요."
    echo "  상세 보고서: build/reports/checkstyle/main.html"
    exit 1
fi

echo "[pre-commit] 통과했습니다."
